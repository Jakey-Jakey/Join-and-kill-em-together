<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone spike plugin proving EOS works under the game's Mono runtime:
       Device ID auth, lobby create/search, P2P echo. Not shipped with the mod. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>JaketEosSpike</AssemblyName>
    <RootNamespace>JaketEosSpike</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.29" />
    <ProjectReference Include="../../lib/eos-sdk/Epic.OnlineServices.csproj" />
  </ItemGroup>

  <Target Name="CopyNativeSdk" AfterTargets="Build">
    <Copy SourceFiles="../../lib/eos-sdk/Natives/EOSSDK-Win64-Shipping.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
